+        private static void NormalizeRuntimeCoreLibraryReferences(ModuleDefinition module)
+        {
+            if (!ReflectionHelper.IsCoreBCL)
+                return;
+
+            AssemblyName runtimeCoreLibrary = typeof(object).Assembly.GetName();
+            foreach (AssemblyNameReference reference in module.AssemblyReferences)
+            {
+                if (!string.Equals(reference.Name, "mscorlib", StringComparison.OrdinalIgnoreCase))
+                    continue;
+
+                // Cecil creates temporary DMD modules with the .NET Framework corelib identity.
+                // Dynamic assemblies loaded by CoreCLR and .NET for iOS must bind those type refs
+                // to the runtime's actual core library instead.
+                reference.Name = runtimeCoreLibrary.Name;
+                reference.Version = runtimeCoreLibrary.Version;
+                reference.Culture = runtimeCoreLibrary.CultureName;
+                reference.PublicKeyToken = runtimeCoreLibrary.GetPublicKeyToken() ?? Array.Empty<byte>();
+            }
+        }
+
