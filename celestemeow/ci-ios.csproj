<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <DefineConstants>$(DefineConstants);__IOS__</DefineConstants>
    <ApplicationTitle>Celeste</ApplicationTitle>
    <ApplicationId>gay.rooot.celestemeow</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AppIcon>AppIcon</AppIcon>
    <InfoPlist>Info.plist</InfoPlist>
    <EnableCodeSigning>false</EnableCodeSigning>
    <EnableDefaultCodesignEntitlements>false</EnableDefaultCodesignEntitlements>
    <BuildIpa>true</BuildIpa>
    <ValidateXcodeVersion>false</ValidateXcodeVersion>
    <UseMonoRuntime>false</UseMonoRuntime>
    <DynamicCodeSupport>true</DynamicCodeSupport>
    <MtouchLink>None</MtouchLink>
    <MtouchNoSymbolStrip>true</MtouchNoSymbolStrip>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../tools/IOSHookWeaver/Program.cs" Link="IOSHookWeaver.cs" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <PackageReference Include="YamlDotNet" Version="16.1.3" />
    <PackageReference Include="KeraLua" Version="1.4.7" />
    <ImageAsset Include="Assets.xcassets/**/*" />
    <BundleResource Include="Content/**/*" TargetPath="Content/%(RecursiveDir)%(Filename)%(Extension)" />
    <BundleResource Include="RuntimeAssemblies/Celeste.dll" Link="Celeste.dll" />
    <BundleResource Include="RuntimeAssemblies/FNA.dll" Link="RuntimeAssemblies/FNA.dll" />
    <BundleResource Include="RuntimeAssemblies/Everest/*.dll" TargetPath="%(Filename)%(Extension)" />
    <BundleResource Include="celeste/mscorlib.dll" />
    <BundleResource Include="celeste/Celeste.Content.dll" />
    <BundleResource Include="celeste/Celeste.dll.config" />
  </ItemGroup>

  <ItemGroup>
    <NativeReference Include="libSDL2.a">
      <Kind>Static</Kind>
      <ForceLoad>true</ForceLoad>
      <IsCxx>true</IsCxx>
      <Frameworks>AVFAudio AVFoundation AudioToolbox CoreAudio CoreBluetooth CoreGraphics CoreHaptics CoreMedia CoreMotion CoreVideo GameController IOSurface Metal MobileCoreServices OpenGLES QuartzCore UIKit VideoToolbox</Frameworks>
    </NativeReference>
    <NativeReference Include="libFNA3D.a">
      <Kind>Static</Kind>
      <ForceLoad>true</ForceLoad>
      <IsCxx>true</IsCxx>
      <Frameworks>CoreGraphics CoreVideo IOSurface Metal QuartzCore UIKit</Frameworks>
    </NativeReference>
    <NativeReference Include="libFAudio.a">
      <Kind>Static</Kind>
      <ForceLoad>true</ForceLoad>
      <IsCxx>true</IsCxx>
      <Frameworks>AVFAudio AVFoundation AudioToolbox CoreAudio CoreMedia</Frameworks>
    </NativeReference>
    <NativeReference Include="libtheorafile.a">
      <Kind>Static</Kind>
      <ForceLoad>true</ForceLoad>
      <IsCxx>true</IsCxx>
      <Frameworks>CoreMedia CoreVideo VideoToolbox</Frameworks>
    </NativeReference>
    <NativeReference Include="libMoltenVK.a">
      <Kind>Static</Kind>
      <ForceLoad>true</ForceLoad>
      <IsCxx>true</IsCxx>
      <Frameworks>CoreGraphics IOSurface Metal QuartzCore</Frameworks>
    </NativeReference>
    <NativeReference Include="libfmod.a">
      <Kind>Static</Kind>
      <ForceLoad>true</ForceLoad>
      <IsCxx>true</IsCxx>
      <Frameworks>AVFAudio AVFoundation AudioToolbox CoreAudio CoreMedia</Frameworks>
    </NativeReference>
    <NativeReference Include="libfmodstudio.a">
      <Kind>Static</Kind>
      <ForceLoad>true</ForceLoad>
      <IsCxx>true</IsCxx>
      <Frameworks>AVFAudio AVFoundation AudioToolbox CoreAudio CoreMedia</Frameworks>
    </NativeReference>
  </ItemGroup>

  <ItemGroup>
    <LinkerArgument Include="-lc++" />
    <LinkerArgument Include="-Wl,-exported_symbol,_SDL_SetHint" />
    <LinkerArgument Include="-Wl,-exported_symbol,_SDL_UIKitRunApp" />
    <LinkerArgument Include="-Wl,-exported_symbol,_SDL_ShowSimpleMessageBox" />
    <LinkerArgument Include="-Wl,-exported_symbol,_tf_gettheorasize" />
    <LinkerArgument Include="-Wl,-exported_symbol,_tf_granpos_dec" />
    <LinkerArgument Include="-Wl,-exported_symbol,_tf_readaudio2" />
    <LinkerArgument Include="-Wl,-exported_symbol,_tf_readvideo2" />
    <LinkerArgument Include="-Wl,-exported_symbol,_FNA3D_GenVertexBuffer" />
    <LinkerArgument Include="-Wl,-exported_symbol,_FNA3D_SetVertexBufferData" />
    <LinkerArgument Include="-Wl,-exported_symbol,_FNA3D_AddDisposeVertexBuffer" />
    <LinkerArgument Include="-Wl,-exported_symbol,_FNA3D_GenIndexBuffer" />
    <LinkerArgument Include="-Wl,-exported_symbol,_FNA3D_SetIndexBufferData" />
    <LinkerArgument Include="-Wl,-exported_symbol,_FNA3D_AddDisposeIndexBuffer" />
    <LinkerArgument Include="-Wl,-exported_symbol,_FNA3D_ApplyVertexBufferBindings" />
    <LinkerArgument Include="-Wl,-exported_symbol,_FNA3D_DrawIndexedPrimitives" />
  </ItemGroup>
</Project>
